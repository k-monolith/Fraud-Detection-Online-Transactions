          "rawSql": "select to_timestamp(processing_ts) as scored_at, transaction_id, event_time, fraud_probability, is_fraud_pred, decision, latency_ms, model_version, error, warnings::text as warnings from scored_transactions order by processing_ts desc limit 100",
