{
 "title": "System Health",
 "uid": "fraud-system-health",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {"from": "now-30m", "to": "now"},
 "timezone": "browser",
 "panels": [
  {"type": "timeseries", "title": "Events/s: raw in, scored out, DLQ",
   "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
   "datasource": {"type": "prometheus", "uid": "prometheus"},
   "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
   "targets": [
    {"expr": "rate(raw_events_total[1m])", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "legendFormat": "raw in"},
    {"expr": "sum(rate(scored_events_total[1m]))", "refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "legendFormat": "scored out"},
    {"expr": "rate(dlq_events_total[1m])", "refId": "C", "datasource": {"type": "prometheus", "uid": "prometheus"}, "legendFormat": "dlq"}
   ]},
  {"type": "timeseries", "title": "Scoring latency (ms)",
   "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
   "datasource": {"type": "prometheus", "uid": "prometheus"},
   "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
   "targets": [
    {"expr": "histogram_quantile(0.5, sum(rate(scoring_latency_ms_bucket[5m])) by (le))", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "legendFormat": "p50"},
    {"expr": "histogram_quantile(0.95, sum(rate(scoring_latency_ms_bucket[5m])) by (le))", "refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "legendFormat": "p95"},
    {"expr": "histogram_quantile(0.99, sum(rate(scoring_latency_ms_bucket[5m])) by (le))", "refId": "C", "datasource": {"type": "prometheus", "uid": "prometheus"}, "legendFormat": "p99"}
   ]},
  {"type": "timeseries", "title": "Scoring consumer lag (transactions.raw)",
   "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
   "datasource": {"type": "prometheus", "uid": "prometheus"},
   "fieldConfig": {"defaults": {}, "overrides": []},
   "targets": [
    {"expr": "sum(scoring_consumer_lag)", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "legendFormat": "lag"}
   ]},
  {"type": "timeseries", "title": "Flink checkpoints: duration + failures",
   "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
   "datasource": {"type": "prometheus", "uid": "prometheus"},
   "fieldConfig": {"defaults": {}, "overrides": []},
   "targets": [
    {"expr": "flink_jobmanager_job_lastCheckpointDuration", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "legendFormat": "last duration (ms)"},
    {"expr": "increase(flink_jobmanager_job_numberOfFailedCheckpoints[10m])", "refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "legendFormat": "failed (10m)"}
   ]},
  {"type": "timeseries", "title": "Flink restarts",
   "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
   "datasource": {"type": "prometheus", "uid": "prometheus"},
   "fieldConfig": {"defaults": {}, "overrides": []},
   "targets": [
    {"expr": "flink_jobmanager_job_numRestarts", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "legendFormat": "restarts"}
   ]},
  {"type": "timeseries", "title": "Backpressure (scoring task)",
   "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
   "datasource": {"type": "prometheus", "uid": "prometheus"},
   "fieldConfig": {"defaults": {}, "overrides": []},
   "targets": [
    {"expr": "max(flink_taskmanager_job_task_isBackPressured)", "refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "legendFormat": "backpressured"}
   ]}
 ]
}
